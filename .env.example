# Base URL of the membership backend (backend-shree-dharmic), without /api/v1.
# The browser calls it directly, so this site's origin must be listed in the backend's
# CORS_ALLOWED_ORIGINS (e.g. http://localhost:3000 locally, https://your-domain in production).
# NEXT_PUBLIC_ values are built into the site: rebuild after changing it.
NEXT_PUBLIC_MEMBERSHIP_API_URL=http://localhost:8100

# Public URL of this site, used for canonical and social-preview (Open Graph) links on /blog posts.
# Must match the backend's SITE_BASE_URL. Rebuild after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
